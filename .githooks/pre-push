#!/bin/sh
# Afaro: sweep every commit message being pushed.
#
# The commit-msg hook catches a message as it is written. This catches the
# ones written before the hook was installed, the ones amended past it, and
# anything rebased in from elsewhere.
#
# Install with: npm run hooks:install

zero='0000000000000000000000000000000000000000'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # A branch the remote has not seen. Sweep back to where it left main.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null)
    if [ -z "$base" ]; then
      base=$(git rev-list --max-parents=0 "$local_sha" | tail -1)
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  node scripts/check-names.js --commits "$range" --allow-missing-list || status=1
done

exit $status
