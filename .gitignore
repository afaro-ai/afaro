# Personal profile data. Never tracked. The second pattern covers the
# per-person files operator mode creates, profile-<name>.json.
profile.json
profile.*.json
profile-*.json
profile_*.json
!profile.example.json

# Local run output. Redacted logs still stay out of git, wherever they land.
logs/
out/
*.log

# Secrets
.env
.env.*

# Node
node_modules/

# OS
.DS_Store
Thumbs.db

# Skill zips built for install, see docs/smoke-test.md
/*.zip

# Unblanked captures from a real run, staged for the blanking step. Never tracked.
incoming/
