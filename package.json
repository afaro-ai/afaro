{
  "name": "afaro-data-removal",
  "version": "0.0.0",
  "private": true,
  "description": "Afaro is a local-first personal-data removal engine. This package holds the manifest validator only.",
  "type": "commonjs",
  "scripts": {
    "validate": "node scripts/validate.js",
    "check:names": "node scripts/check-names.js",
    "hooks:install": "git config core.hooksPath .githooks",
    "test": "node tests/validate.test.js && node tests/check-names.test.js",
    "smoke": "node scripts/serve-smoke.js",
    "validate:smoke": "node scripts/validate.js --dir manifests/_smoke"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
